# EC2 dev 인프라(docker-compose.dev-infra.yml) 환경변수 — /etc/liveclass/.env.dev 로 채운다(커밋 금지).
# prod과 분리된 dev 인스턴스. 팀이 로컬 개발 중 붙는 공유 인프라.
POSTGRES_USER=liveclass
POSTGRES_DB=liveclass
POSTGRES_PASSWORD=change-me-dev
REDIS_PASSWORD=change-me-dev
RABBITMQ_USER=liveclass
RABBITMQ_PASSWORD=change-me-dev

# MinIO (에셋 스토리지, dev)
MINIO_ROOT_USER=liveclass
MINIO_ROOT_PASSWORD=change-me-dev

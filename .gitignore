# 팀원 개별 실습(Sub PJT1). 이미 원격에 올라간 것은 유지, 이후 새 변경만 무시.
sub1/

# Frontend build output (FE/BE 분리 — frontend/dist 로컬 산출)
frontend/dist/

# Application logs (rolled/compressed logs live here too)
logs/

# Node dependencies (root: concurrently)
node_modules/

# npm lockfiles: 루트(concurrently)는 미추적. 프론트는 Docker `npm ci` 재현빌드/CI 배포 전제라 추적.
package-lock.json
!frontend/package-lock.json

# oh-my-claudecode operational state
.omc/

# AI 하네스: 팀 공용 .claude/ 는 커밋, 개인 설정만 무시
.claude/settings.local.json

# 로컬 인프라 시크릿 (.env.example / .env.prod.example / .env.remote.example만 커밋)
.env
.env.prod
.env.remote

# 에디터 스왑/임시 파일
*.swp
*~

# IDE
.idea/
.vscode/*.local

# Gradle 빌드 산출물
backend/build/
backend/.gradle/

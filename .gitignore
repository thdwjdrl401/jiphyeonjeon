# 팀원 개별 실습(Sub PJT1). 이미 원격에 올라간 것은 유지, 이후 새 변경만 무시.
sub1/

# Frontend build output (FE/BE 분리 — frontend/dist 로컬 산출)
frontend/dist/

# Application logs (rolled/compressed logs live here too)
logs/

# Node dependencies (root: concurrently)
node_modules/

# npm lockfiles: 루트(concurrently)는 미추적. 프론트는 Docker `npm ci` 재현빌드/CI 배포 전제라 추적.
package-lock.json
!frontend/package-lock.json

# oh-my-claudecode operational state
.omc/

# AI 하네스: 팀 공용 .claude/ 는 커밋, 개인 설정만 무시
.claude/settings.local.json
# 에이전트용 git worktree는 리포 안에 생기지만 소스가 아니다 — 커밋되면 삭제한 파일이
# 사본으로 되살아난다(git add -A 사고 방지).
.claude/worktrees/

# 로컬 인프라 시크릿 (.env.example / .env.prod.example / .env.remote.example만 커밋)
.env
.env.prod
.env.dev
.env.remote
.env.ai-prod

# SSH/private key material must never be committed. Keep deployment keys in ~/.config/liveclass/ssh/.
*.pem

# 에디터 스왑/임시 파일
*.swp
*~

# IDE
.idea/
.vscode/*.local

# Gradle 빌드 산출물
backend/build/
backend/.gradle/

# LiveKit STT 테스트 미디어(대용량 바이너리) — 호스트 /srv/liveclass/stt-audio 에만 둔다
infra/livekit/stt-audio/

# 아키텍처 다이어그램 생성 스크립트의 출력물 (원본은 liveclass-architecture.drawio)
docs/architecture/**/*.generated.drawio

# 파이썬 캐시
__pycache__/
*.pyc

image/

# 개인 학습
docs/learning/

{
  "name": "webmobile1-skeleton",
  "version": "1.0.0",
  "private": true,
  "description": "실시간 그룹 화상 회의 서비스 - 루트 통합 실행 스크립트 (frontend + backend)",
  "scripts": {
    "dev": "concurrently -k -n FE,BE,WATCH -c green,blue,magenta \"npm run fe:dev\" \"npm run be:dev\" \"npm run be:watch\"",
    "fe:dev": "npm --prefix frontend run dev",
    "be:dev": "cd backend && .\\gradlew.bat bootRun",
    "be:watch": "cd backend && .\\gradlew.bat -t compileJava",
    "start": "cd backend && .\\gradlew.bat bootRun",
    "build:fe": "npm --prefix frontend run build",
    "build": "cd backend && .\\gradlew.bat clean build",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}

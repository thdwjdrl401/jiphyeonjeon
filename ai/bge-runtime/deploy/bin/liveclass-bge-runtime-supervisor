#!/bin/sh
set -eu

COMMAND="${1:-status}"
SELF_PATH="$(readlink -f "$0")"
DEPLOY_ROOT="${LIVECLASS_BGE_DEPLOY_ROOT:-$HOME/.local/share/liveclass/bge-runtime}"
CURRENT_LINK="$DEPLOY_ROOT/current"
CONFIG_DIR="${LIVECLASS_CONFIG_DIR:-$HOME/.config/liveclass}"
RUNTIME_ENV="${LIVECLASS_BGE_RUNTIME_ENV:-$CONFIG_DIR/bge-runtime.env}"
TUNNEL_ENV="${LIVECLASS_BGE_TUNNEL_ENV:-$CONFIG_DIR/bge-tunnel.env}"
RUNTIME_SESSION="${LIVECLASS_BGE_RUNTIME_SESSION:-liveclass-bge-runtime}"
TUNNEL_SESSION="${LIVECLASS_BGE_TUNNEL_SESSION:-liveclass-bge-ec2-tunnel}"
RESTART_DELAY_SECONDS="${LIVECLASS_BGE_RESTART_DELAY_SECONDS:-5}"
READY_URL="${LIVECLASS_BGE_READY_URL:-http://127.0.0.1:8020/readyz}"
RUN_DIR="$DEPLOY_ROOT/run"
TUNNEL_READY_FILE="$RUN_DIR/tunnel.ready"

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "required command is missing: $1" >&2
        exit 1
    }
}

require_file() {
    if [ ! -r "$1" ]; then
        echo "required file is not readable: $1" >&2
        exit 1
    fi
}

load_env() {
    require_file "$1"
    set -a
    # Environment files are user-owned secrets and intentionally use shell KEY=value syntax.
    # shellcheck disable=SC1090
    . "$1"
    set +a
}

session_exists() {
    tmux has-session -t "=$1" 2>/dev/null
}

start_runtime() {
    if session_exists "$RUNTIME_SESSION"; then
        echo "bge-runtime supervisor is already running"
        return
    fi
    require_file "$RUNTIME_ENV"
    require_file "$CURRENT_LINK/.venv/bin/python"
    tmux new-session -d -s "$RUNTIME_SESSION" \
        "$SELF_PATH _run-runtime"
    echo "bge-runtime supervisor started"
}

start_tunnel() {
    if session_exists "$TUNNEL_SESSION"; then
        echo "BGE tunnel supervisor is already running"
        return
    fi
    require_file "$TUNNEL_ENV"
    require_file "$CURRENT_LINK/scripts/start_ec2_reverse_tunnel.sh"
    install -d -m 0700 "$RUN_DIR"
    rm -f "$TUNNEL_READY_FILE"
    tmux new-session -d -s "$TUNNEL_SESSION" \
        "$SELF_PATH _run-tunnel"
    echo "BGE tunnel supervisor started"
}

stop_session() {
    if session_exists "$1"; then
        tmux kill-session -t "=$1"
    fi
}

show_runtime_status() {
    if session_exists "$RUNTIME_SESSION"; then
        echo "bge-runtime: running"
        return 0
    fi
    echo "bge-runtime: stopped"
    return 1
}

show_tunnel_status() {
    if session_exists "$TUNNEL_SESSION" && [ -s "$TUNNEL_READY_FILE" ]; then
        echo "BGE tunnel: running"
        return 0
    fi
    if session_exists "$TUNNEL_SESSION"; then
        echo "BGE tunnel: starting"
    else
        echo "BGE tunnel: stopped"
    fi
    return 1
}

show_status() {
    status=0
    show_runtime_status || status=1
    show_tunnel_status || status=1
    return "$status"
}

require_command tmux

case "$COMMAND" in
    _run-runtime)
        load_env "$RUNTIME_ENV"
        # This host is limited to one physical GPU. Never allow this service to select GPU 1.
        CUDA_VISIBLE_DEVICES=0
        BGE_RUNTIME_DEVICE=cuda
        export CUDA_VISIBLE_DEVICES BGE_RUNTIME_DEVICE
        cd "$CURRENT_LINK"
        while :; do
            set +e
            "$CURRENT_LINK/.venv/bin/python" -m app.main
            runtime_status=$?
            set -e
            echo "bge-runtime exited with status $runtime_status; retrying in ${RESTART_DELAY_SECONDS}s" >&2
            sleep "$RESTART_DELAY_SECONDS"
        done
        ;;
    _run-tunnel)
        load_env "$TUNNEL_ENV"
        install -d -m 0700 "$RUN_DIR"
        tunnel_pid=
        stop_tunnel_child() {
            rm -f "$TUNNEL_READY_FILE"
            if [ -n "$tunnel_pid" ] && kill -0 "$tunnel_pid" 2>/dev/null; then
                kill "$tunnel_pid" 2>/dev/null || true
                wait "$tunnel_pid" 2>/dev/null || true
            fi
            exit 0
        }
        trap stop_tunnel_child HUP INT TERM
        while :; do
            rm -f "$TUNNEL_READY_FILE"
            set +e
            "$CURRENT_LINK/scripts/start_ec2_reverse_tunnel.sh" &
            tunnel_pid=$!
            sleep 2
            if kill -0 "$tunnel_pid" 2>/dev/null; then
                printf '%s\n' "$tunnel_pid" >"$TUNNEL_READY_FILE"
            fi
            wait "$tunnel_pid"
            tunnel_status=$?
            set -e
            tunnel_pid=
            rm -f "$TUNNEL_READY_FILE"
            echo "BGE tunnel exited with status $tunnel_status; retrying in ${RESTART_DELAY_SECONDS}s" >&2
            sleep "$RESTART_DELAY_SECONDS"
        done
        ;;
    start)
        start_runtime
        start_tunnel
        ;;
    start-runtime)
        start_runtime
        ;;
    start-tunnel)
        start_tunnel
        ;;
    restart)
        stop_session "$TUNNEL_SESSION"
        stop_session "$RUNTIME_SESSION"
        start_runtime
        start_tunnel
        ;;
    restart-runtime)
        stop_session "$RUNTIME_SESSION"
        start_runtime
        ;;
    restart-tunnel)
        stop_session "$TUNNEL_SESSION"
        start_tunnel
        ;;
    stop)
        stop_session "$TUNNEL_SESSION"
        rm -f "$TUNNEL_READY_FILE"
        stop_session "$RUNTIME_SESSION"
        ;;
    stop-runtime)
        stop_session "$RUNTIME_SESSION"
        ;;
    stop-tunnel)
        stop_session "$TUNNEL_SESSION"
        rm -f "$TUNNEL_READY_FILE"
        ;;
    status)
        show_status
        ;;
    status-runtime)
        show_runtime_status
        ;;
    status-tunnel)
        show_tunnel_status
        ;;
    health)
        show_status
        require_command curl
        curl --fail --silent --show-error --max-time 5 "$READY_URL" >/dev/null
        echo "bge-runtime: ready"
        ;;
    logs-runtime)
        tmux capture-pane -p -t "$RUNTIME_SESSION:0.0" -S -200
        ;;
    logs-tunnel)
        tmux capture-pane -p -t "$TUNNEL_SESSION:0.0" -S -200
        ;;
    *)
        echo "usage: liveclass-bge-runtime-supervisor {start|start-runtime|start-tunnel|restart|restart-runtime|restart-tunnel|stop|stop-runtime|stop-tunnel|status|status-runtime|status-tunnel|health|logs-runtime|logs-tunnel}" >&2
        exit 2
        ;;
esac

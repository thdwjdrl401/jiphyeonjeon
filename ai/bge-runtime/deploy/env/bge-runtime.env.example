# Keep this file chmod 0600. The supervisor forces CUDA_VISIBLE_DEVICES=0 and
# BGE_RUNTIME_DEVICE=cuda regardless of values inherited by the runner.
BGE_RUNTIME_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
BGE_RUNTIME_HOST=127.0.0.1
BGE_RUNTIME_PORT=8020
BGE_RUNTIME_BATCH_SIZE=4
BGE_RUNTIME_MAX_BATCH_SIZE=4
BGE_RUNTIME_MAX_INFLIGHT_REQUESTS=8
BGE_RUNTIME_MAX_TEXT_CHARS=4000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

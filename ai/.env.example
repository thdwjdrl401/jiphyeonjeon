# ai 폴더 전체(ai-api, realtime-agent) 로컬 환경변수 예시 — 복사해서 ai/.env로 사용한다.
# 실제 secret과 token은 커밋하지 않는다. 로드 방법(각 서비스 폴더 안에서 실행 시):
#   uv run --env-file ../.env python -m app.main

# =============================================================================
# EC2 ai-api · 내부 인증 및 GMS 답변 모델
# =============================================================================
AI_API_DATABASE_URL=postgresql+asyncpg://liveclass:liveclass@127.0.0.1:5432/liveclass
AI_API_BGE_BASE_URL=http://127.0.0.1:8020
AI_API_BGE_TOKEN=local-bge-token-change-me-00000001
# 발급받은 GMS 키는 이 빈 값에만 넣는다. STT용 OPENAI_API_KEY와 공유하지 않는다.
AI_API_GMS_API_KEY=
AI_API_GMS_MODEL=gpt-4.1
AI_API_GMS_MAX_OUTPUT_TOKENS=1024
# 상위 RAG model timeout(60초)보다 짧게 둔다.
AI_API_GMS_TIMEOUT_SECONDS=55
# RAG와 강의 노트 consumer가 공유하는 application Redis. consumer group은 서로 분리된다.
AI_API_REDIS_URL=redis://127.0.0.1:6379/0
AI_API_INSTANCE_ID=ai-api-local-1
# 비워두면 AI_API_GMS_MODEL을 사용한다.
AI_API_LECTURE_NOTE_MODEL=
AI_API_LECTURE_NOTE_MAX_OUTPUT_TOKENS=512
AI_API_LECTURE_NOTE_TIMEOUT_SECONDS=30
AI_API_LECTURE_NOTE_REFINEMENT_MAX_OUTPUT_TOKENS=4096
AI_API_LECTURE_NOTE_REFINEMENT_MAX_PROMPT_CHARS=50000
AI_API_LECTURE_NOTE_REFINEMENT_TIMEOUT_SECONDS=55
AI_API_LECTURE_NOTE_GMS_MAX_CONCURRENCY=4
AI_API_LECTURE_NOTE_GMS_REFINEMENT_MAX_CONCURRENCY=1
AI_API_LECTURE_NOTE_GMS_MAX_CONSECUTIVE_LIVE=8
AI_API_LECTURE_NOTE_GMS_MAX_ATTEMPTS=3
AI_API_LECTURE_NOTE_GMS_RETRY_BASE_SECONDS=0.5
AI_API_LECTURE_NOTE_GMS_RETRY_MAX_SECONDS=5
# Spring → ai-api S2S 인증 공유 시크릿 (ADR-0023 §9, prefix 없음). 미설정 시 fail-closed 503 유지.
AI_INTERNAL_SECRET=


# =============================================================================
# LiveKit 연결
# =============================================================================
LIVEKIT_URL=wss://livekit.example
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# 수동 room probe에서만 사용하는 참가자 토큰이다. agent worker와 dispatch 인증에는 사용하지 않는다.
LIVEKIT_TOKEN=


# =============================================================================
# STT Agent 및 Provider
# =============================================================================
# Spring의 explicit dispatch agent name과 동일해야 한다.
STT_AGENT_NAME=liveclass-realtime-stt
# realtime-agent 전용 loopback service health. 외부 bind는 거부한다.
STT_HEALTH_HOST=127.0.0.1
STT_HEALTH_PORT=8081


# 선택값: stub | openai-realtime | nemotron
# Nemotron 사용 전: cd ai/realtime-agent && uv sync --extra nemotron
STT_ENGINE_PROVIDER=stub


# =============================================================================
# LiveKit 구독 대상
# =============================================================================
# 로컬 검증 기본값은 infra/livekit의 av-bot fixture를 사용한다.
STT_ROOM=stt-test
AGENT_IDENTITY=realtime-agent
AGENT_TARGET_IDENTITY=av-bot


# =============================================================================
# App Redis 및 실시간 자막 Stream
# =============================================================================
# 루트 docker-compose.yml의 app Redis다. infra/livekit 내부 Redis와는 별개다.
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY_PREFIX=stt
CAPTION_STREAM_KEY=ai:captions:live

# 중복 realtime-agent job 방어 lease. heartbeat 주기는 이 값의 1/3이다.
SESSION_LEASE_TTL_SECONDS=30


# =============================================================================
# Spring lifecycle callback
# =============================================================================
SPRING_STATUS_CALLBACK_ENABLED=false
SPRING_STATUS_CALLBACK_URL=http://localhost:8080/internal/v1/ai/live-agent-status
AI_CALLBACK_SECRET=
SPRING_STATUS_CALLBACK_TIMEOUT_SECONDS=3


# =============================================================================
# OpenAI Realtime Transcription
# =============================================================================
# STT_ENGINE_PROVIDER=openai-realtime일 때 사용한다.
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# 선택값: minimal | low | medium | high | xhigh
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low


# =============================================================================
# Nemotron
# =============================================================================
# STT_ENGINE_PROVIDER=nemotron일 때 사용한다.
# 로컬 모델 경로 또는 Hugging Face model ID를 지정한다. 최초 실행 시 가중치를 다운로드한다.
ASR_MODEL_ID=
ASR_LANGUAGE=ko-KR


# =============================================================================
# CLOVA Speech
# =============================================================================
# STT_ENGINE_PROVIDER=clova일 때 사용한다.
CLOVA_SPEECH_CLIENT_ID=
CLOVA_SPEECH_CLIENT_SECRET=
CLOVA_SPEECH_LANG=Kor


# =============================================================================
# 로그
# =============================================================================
LOG_LEVEL=INFO

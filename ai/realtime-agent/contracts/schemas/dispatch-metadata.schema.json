{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveclass.local/ai-candidates/dispatch-metadata.schema.json",
  "title": "RealtimeAgentDispatchMetadataCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sessionId", "lessonId", "correlationId"],
  "properties": {
    "contractVersion": {"const": "1"},
    "sessionId": {"$ref": "#/$defs/canonicalUuid"},
    "lessonId": {"$ref": "#/$defs/canonicalUuid"},
    "correlationId": {"$ref": "#/$defs/safeIdentifier"}
  },
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}

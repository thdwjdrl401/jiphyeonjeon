{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveclass.local/ai-candidates/caption-stream-entry.schema.json",
  "title": "RealtimeCaptionStreamEntryCandidateV1",
  "oneOf": [
    {"$ref": "#/$defs/started"},
    {"$ref": "#/$defs/delta"},
    {"$ref": "#/$defs/segmentFinal"},
    {"$ref": "#/$defs/completed"}
  ],
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonNegativeIntegerString": {
      "type": "string",
      "maxLength": 18,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "positiveIntegerString": {
      "type": "string",
      "maxLength": 18,
      "pattern": "^[1-9][0-9]*$"
    },
    "commonProperties": {
      "contractVersion": {"const": "1"},
      "eventId": {"$ref": "#/$defs/safeIdentifier"},
      "sessionId": {"$ref": "#/$defs/canonicalUuid"},
      "lessonId": {"$ref": "#/$defs/canonicalUuid"},
      "occurredAt": {"type": "string", "format": "date-time"}
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "eventId", "type", "sessionId", "lessonId",
        "sttSessionId", "audioStartedAt", "occurredAt"
      ],
      "properties": {
        "contractVersion": {"const": "1"},
        "eventId": {"$ref": "#/$defs/safeIdentifier"},
        "type": {"const": "caption.stream.started"},
        "sessionId": {"$ref": "#/$defs/canonicalUuid"},
        "lessonId": {"$ref": "#/$defs/canonicalUuid"},
        "sttSessionId": {"$ref": "#/$defs/safeIdentifier"},
        "audioStartedAt": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
        "occurredAt": {"type": "string", "format": "date-time"}
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "eventId", "type", "sessionId", "lessonId",
        "sttSessionId", "sequence", "streamElapsedMs", "text", "occurredAt"
      ],
      "properties": {
        "contractVersion": {"const": "1"},
        "eventId": {"$ref": "#/$defs/safeIdentifier"},
        "type": {"const": "caption.delta"},
        "sessionId": {"$ref": "#/$defs/canonicalUuid"},
        "lessonId": {"$ref": "#/$defs/canonicalUuid"},
        "sttSessionId": {"$ref": "#/$defs/safeIdentifier"},
        "sequence": {"$ref": "#/$defs/positiveIntegerString"},
        "streamElapsedMs": {"$ref": "#/$defs/nonNegativeIntegerString"},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "occurredAt": {"type": "string", "format": "date-time"}
      }
    },
    "segmentFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "eventId", "type", "sessionId", "lessonId",
        "sttSessionId", "segmentIndex", "lastSequence", "text",
        "startStreamElapsedMs", "endStreamElapsedMs", "boundaryReason", "occurredAt"
      ],
      "properties": {
        "contractVersion": {"const": "1"},
        "eventId": {"$ref": "#/$defs/safeIdentifier"},
        "type": {"const": "caption.segment.final"},
        "sessionId": {"$ref": "#/$defs/canonicalUuid"},
        "lessonId": {"$ref": "#/$defs/canonicalUuid"},
        "sttSessionId": {"$ref": "#/$defs/safeIdentifier"},
        "segmentIndex": {"$ref": "#/$defs/nonNegativeIntegerString"},
        "lastSequence": {"$ref": "#/$defs/positiveIntegerString"},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "startStreamElapsedMs": {"$ref": "#/$defs/nonNegativeIntegerString"},
        "endStreamElapsedMs": {"$ref": "#/$defs/nonNegativeIntegerString"},
        "boundaryReason": {
          "enum": ["SILENCE", "MAX_DURATION", "STREAM_END"]
        },
        "occurredAt": {"type": "string", "format": "date-time"}
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "eventId", "type", "sessionId", "lessonId",
        "sttSessionId", "lastSequence", "streamElapsedMs", "reason", "occurredAt"
      ],
      "properties": {
        "contractVersion": {"const": "1"},
        "eventId": {"$ref": "#/$defs/safeIdentifier"},
        "type": {"const": "caption.stream.completed"},
        "sessionId": {"$ref": "#/$defs/canonicalUuid"},
        "lessonId": {"$ref": "#/$defs/canonicalUuid"},
        "sttSessionId": {"$ref": "#/$defs/safeIdentifier"},
        "lastSequence": {"$ref": "#/$defs/nonNegativeIntegerString"},
        "streamElapsedMs": {"$ref": "#/$defs/nonNegativeIntegerString"},
        "reason": {"const": "ROOM_DELETED"},
        "occurredAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}

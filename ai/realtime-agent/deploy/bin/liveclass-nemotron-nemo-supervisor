#!/bin/sh
set -eu

COMMAND="${1:-status}"
CONFIG_DIR="${LIVECLASS_CONFIG_DIR:-$HOME/.config/liveclass}"
RUNTIME_ENV="${LIVECLASS_NEMOTRON_NEMO_ENV:-$CONFIG_DIR/nemotron-nemo.env}"
SESSION="${LIVECLASS_NEMOTRON_NEMO_SESSION:-liveclass-nemotron-nemo}"
RESTART_DELAY_SECONDS="${LIVECLASS_RESTART_DELAY_SECONDS:-5}"
SCRIPT_PATH="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename "$0")"

require_file() {
    if [ ! -r "$1" ]; then
        echo "required file is not readable: $1" >&2
        exit 1
    fi
}

load_runtime_env() {
    require_file "$RUNTIME_ENV"
    set -a
    # User-owned secret file using shell KEY=value syntax.
    # shellcheck disable=SC1090
    . "$RUNTIME_ENV"
    set +a
}

session_exists() {
    tmux has-session -t "=$SESSION" 2>/dev/null
}

validate_runtime_env() {
    load_runtime_env
    : "${NEMO_RUNTIME_VENV:?NEMO_RUNTIME_VENV is required}"
    : "${NEMO_RUNTIME_MODEL_PATH:?NEMO_RUNTIME_MODEL_PATH is required}"
    : "${NEMO_RUNTIME_SERVED_MODEL_NAME:?NEMO_RUNTIME_SERVED_MODEL_NAME is required}"
    : "${NEMO_RUNTIME_PORT:?NEMO_RUNTIME_PORT is required}"
    NEMO_RUNTIME_REPLICAS="${NEMO_RUNTIME_REPLICAS:-1}"
    if [ "${CUDA_VISIBLE_DEVICES:-}" != "0" ]; then
        echo "Nemotron NeMo runtime is restricted to GPU 0" >&2
        exit 1
    fi
    if [ "${NEMO_RUNTIME_HOST:-}" != "127.0.0.1" ]; then
        echo "NEMO_RUNTIME_HOST must be 127.0.0.1" >&2
        exit 1
    fi
    case "$NEMO_RUNTIME_PORT" in
        *[!0-9]*|"")
            echo "NEMO_RUNTIME_PORT must be numeric" >&2
            exit 1
            ;;
    esac
    if [ "$NEMO_RUNTIME_PORT" -lt 1 ] || [ "$NEMO_RUNTIME_PORT" -gt 65535 ]; then
        echo "NEMO_RUNTIME_PORT must be between 1 and 65535" >&2
        exit 1
    fi
    case "$NEMO_RUNTIME_REPLICAS" in
        *[!0-9]*|"")
            echo "NEMO_RUNTIME_REPLICAS must be numeric" >&2
            exit 1
            ;;
    esac
    if [ "$NEMO_RUNTIME_REPLICAS" -lt 1 ] || [ "$NEMO_RUNTIME_REPLICAS" -gt 5 ]; then
        echo "NEMO_RUNTIME_REPLICAS must be between 1 and 5" >&2
        exit 1
    fi
    if [ ! -x "$NEMO_RUNTIME_VENV/bin/python" ]; then
        echo "NeMo Python is not installed: $NEMO_RUNTIME_VENV/bin/python" >&2
        exit 1
    fi
    if [ ! -r "$NEMO_RUNTIME_MODEL_PATH" ]; then
        echo "Nemotron .nemo checkpoint is not readable: $NEMO_RUNTIME_MODEL_PATH" >&2
        exit 1
    fi
}

probe_runtime() {
    load_runtime_env
    "$NEMO_RUNTIME_VENV/bin/python" -c '
import json
import os
import urllib.request

host = os.environ["NEMO_RUNTIME_HOST"]
port = os.environ["NEMO_RUNTIME_PORT"]
url = "http://{}:{}/v1/models".format(host, port)
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
with opener.open(url, timeout=2) as response:
    payload = json.load(response)
models = {
    item.get("id")
    for item in payload.get("data", [])
    if isinstance(item, dict)
}
if os.environ["NEMO_RUNTIME_SERVED_MODEL_NAME"] not in models:
    raise SystemExit("configured served model is absent from /v1/models")
'
}

run_runtime() {
    validate_runtime_env
    export CUDA_VISIBLE_DEVICES=0
    runtime_server="${NEMO_RUNTIME_SERVER:-$HOME/.local/share/liveclass/realtime-agent/current/deploy/runtime/nemotron_nemo_server.py}"
    require_file "$runtime_server"
    while :; do
        set +e
        "$NEMO_RUNTIME_VENV/bin/python" "$runtime_server" \
            --checkpoint "$NEMO_RUNTIME_MODEL_PATH" \
            --served-model "$NEMO_RUNTIME_SERVED_MODEL_NAME" \
            --host "$NEMO_RUNTIME_HOST" \
            --port "$NEMO_RUNTIME_PORT" \
            --replicas "$NEMO_RUNTIME_REPLICAS" \
            --device cuda
        runtime_status=$?
        set -e
        echo "NeMo runtime exited with status $runtime_status; retrying in ${RESTART_DELAY_SECONDS}s" >&2
        sleep "$RESTART_DELAY_SECONDS"
    done
}

case "$COMMAND" in
    _run)
        run_runtime
        ;;
    start)
        command -v tmux >/dev/null 2>&1 || {
            echo "required command is missing: tmux" >&2
            exit 1
        }
        validate_runtime_env
        if session_exists; then
            echo "Nemotron NeMo runtime is already running"
            exit 0
        fi
        tmux new-session -d -s "$SESSION" "$SCRIPT_PATH _run"
        echo "Nemotron NeMo runtime supervisor started"
        ;;
    restart)
        if session_exists; then
            tmux kill-session -t "=$SESSION"
        fi
        "$SCRIPT_PATH" start
        ;;
    stop)
        if session_exists; then
            tmux kill-session -t "=$SESSION"
        fi
        ;;
    status)
        if ! session_exists; then
            echo "Nemotron NeMo runtime: stopped"
            exit 1
        fi
        probe_runtime
        echo "Nemotron NeMo runtime: ready"
        ;;
    health)
        probe_runtime
        ;;
    logs)
        if ! session_exists; then
            echo "Nemotron NeMo runtime: stopped"
            exit 1
        fi
        tmux capture-pane -p -t "$SESSION:0.0" -S -200
        ;;
    *)
        echo "usage: liveclass-nemotron-nemo-supervisor {start|restart|stop|status|health|logs}" >&2
        exit 2
        ;;
esac

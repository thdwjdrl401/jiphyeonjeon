#!/bin/sh
set -eu

if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required" >&2
    exit 1
fi

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
VLLM_VERSION="${WHISPER_VLLM_VERSION:-0.14.0}"
QWEN_ASR_VERSION="${QWEN_ASR_VERSION:-0.0.6}"
TORCH_BACKEND="${WHISPER_VLLM_TORCH_BACKEND:-cu128}"
VLLM_VENV="${WHISPER_VLLM_VENV:-$DATA_HOME/liveclass/qwen3-asr-vllm/vllm-$VLLM_VERSION-$TORCH_BACKEND}"

mkdir -p "$(dirname "$VLLM_VENV")"
if [ ! -x "$VLLM_VENV/bin/python" ]; then
    uv venv "$VLLM_VENV" --python 3.12 --seed
fi

uv pip install \
    --python "$VLLM_VENV/bin/python" \
    "qwen-asr[vllm]==$QWEN_ASR_VERSION" \
    --torch-backend="$TORCH_BACKEND"

"$VLLM_VENV/bin/python" -c "import qwen_asr, vllm; print(vllm.__version__)"

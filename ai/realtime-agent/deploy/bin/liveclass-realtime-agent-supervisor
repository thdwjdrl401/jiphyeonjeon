#!/bin/sh
set -eu

COMMAND="${1:-status}"
DEPLOY_ROOT="${LIVECLASS_DEPLOY_ROOT:-$HOME/.local/share/liveclass/realtime-agent}"
CURRENT_LINK="$DEPLOY_ROOT/current"
CONFIG_DIR="${LIVECLASS_CONFIG_DIR:-$HOME/.config/liveclass}"
COMMON_AGENT_ENV="${LIVECLASS_COMMON_AGENT_ENV:-$CONFIG_DIR/realtime-agent-common.env}"
PROD_AGENT_ENV="${LIVECLASS_PROD_AGENT_ENV:-$CONFIG_DIR/realtime-agent.env}"
DEV_AGENT_ENV="${LIVECLASS_DEV_AGENT_ENV:-$CONFIG_DIR/realtime-agent-dev.env}"
TUNNEL_ENV="${LIVECLASS_TUNNEL_ENV:-$CONFIG_DIR/realtime-agent-tunnels.env}"
PROD_AGENT_SESSION="${LIVECLASS_PROD_AGENT_SESSION:-liveclass-realtime-agent-prod}"
DEV_AGENT_SESSION="${LIVECLASS_DEV_AGENT_SESSION:-liveclass-realtime-agent-dev}"
LEGACY_AGENT_SESSION="liveclass-realtime-agent"
TUNNEL_SESSION="${LIVECLASS_TUNNEL_SESSION:-liveclass-realtime-agent-tunnels}"
RESTART_DELAY_SECONDS="${LIVECLASS_RESTART_DELAY_SECONDS:-5}"

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "required command is missing: $1" >&2
        exit 1
    }
}

require_file() {
    if [ ! -r "$1" ]; then
        echo "required file is not readable: $1" >&2
        exit 1
    fi
}

load_env() {
    require_file "$1"
    set -a
    # The environment files are user-owned secrets and intentionally use shell KEY=value syntax.
    # shellcheck disable=SC1090
    . "$1"
    set +a
}
load_agent_env() {
    require_file "$COMMON_AGENT_ENV"
    unset LIVEKIT_URL LIVEKIT_TUNNEL_HOST LIVEKIT_API_KEY LIVEKIT_API_SECRET \
        LIVEKIT_TURN_URL LIVEKIT_TURN_SECRET REDIS_URL CAPTION_STREAM_KEY \
        SESSION_LEASE_TTL_SECONDS SPRING_STATUS_CALLBACK_ENABLED \
        SPRING_STATUS_CALLBACK_URL SPRING_STATUS_CALLBACK_TIMEOUT_SECONDS \
        SPRING_STATUS_CALLBACK_ATTEMPTS AI_CALLBACK_SECRET ASR_LANGUAGE LOG_LEVEL \
        STT_AGENT_NAME STT_ENGINE_PROVIDER STT_HEALTH_HOST STT_HEALTH_PORT \
        STT_MAX_ACTIVE_JOBS STT_NUM_IDLE_PROCESSES CUDA_VISIBLE_DEVICES ASR_MODEL_ID \
        OPENAI_API_KEY OPENAI_REALTIME_TRANSCRIPTION_MODEL \
        OPENAI_REALTIME_TRANSCRIPTION_DELAY VLLM_WHISPER_BASE_URL \
        VLLM_WHISPER_MODEL VLLM_API_KEY VLLM_WHISPER_REQUEST_TIMEOUT_SECONDS \
        VLLM_WHISPER_CONNECT_TIMEOUT_SECONDS \
        NEMO_RUNTIME_BASE_URL NEMO_RUNTIME_MODEL NEMO_RUNTIME_REQUEST_TIMEOUT_SECONDS \
        NEMO_RUNTIME_CONNECT_TIMEOUT_SECONDS
    load_env "$COMMON_AGENT_ENV"
    load_env "$1"
}


validate_agent_env_profile() {
    profile="$1"
    env_file="$2"
    expected_name="$3"
    expected_health_port="$4"
    (
        load_agent_env "$env_file"
        if [ "${STT_AGENT_NAME:-}" != "$expected_name" ] || \
            [ "${STT_HEALTH_HOST:-}" != "127.0.0.1" ] || \
            [ "${STT_HEALTH_PORT:-}" != "$expected_health_port" ] || \
            [ -z "${STT_MAX_ACTIVE_JOBS:-}" ] || \
            [ -z "${STT_NUM_IDLE_PROCESSES:-}" ] || \
            [ -z "${STT_ENGINE_PROVIDER:-}" ]; then
            echo "$profile agent env profile mismatch" >&2
            exit 1
        fi
        case "$profile:${REDIS_URL:-}" in
            prod:redis://127.0.0.1:6390/*)
                ;;
            dev:redis://:?*@127.0.0.1:4000/*)
                ;;
            *)
                echo "$profile agent Redis endpoint mismatch" >&2
                exit 1
                ;;
        esac
        case "$STT_ENGINE_PROVIDER" in
            nemotron)
                if [ "${CUDA_VISIBLE_DEVICES:-}" != "0" ] || \
                    [ -z "${ASR_MODEL_ID:-}" ]; then
                    echo "$profile nemotron env profile mismatch" >&2
                    exit 1
                fi
                ;;
            openai-realtime)
                if [ "${STT_MAX_ACTIVE_JOBS:-}" != "1" ] || \
                    [ "${STT_NUM_IDLE_PROCESSES:-}" != "1" ] || \
                    [ -z "${OPENAI_API_KEY:-}" ] || \
                    [ -z "${OPENAI_REALTIME_TRANSCRIPTION_MODEL:-}" ] || \
                    [ -z "${OPENAI_REALTIME_TRANSCRIPTION_DELAY:-}" ]; then
                    echo "$profile openai-realtime env profile mismatch" >&2
                    exit 1
                fi
                ;;
            nemotron-nemo)
                if [ "${STT_MAX_ACTIVE_JOBS:-}" != "1" ] || \
                    [ "${STT_NUM_IDLE_PROCESSES:-}" != "1" ] || \
                    [ -z "${NEMO_RUNTIME_BASE_URL:-}" ] || \
                    [ -z "${NEMO_RUNTIME_MODEL:-}" ] || \
                    [ -z "${NEMO_RUNTIME_REQUEST_TIMEOUT_SECONDS:-}" ] || \
                    [ -z "${NEMO_RUNTIME_CONNECT_TIMEOUT_SECONDS:-}" ]; then
                    echo "$profile nemotron-nemo env profile mismatch" >&2
                    exit 1
                fi
                ;;
            vllm-whisper)
                if [ "${STT_MAX_ACTIVE_JOBS:-}" != "1" ] || \
                    [ "${STT_NUM_IDLE_PROCESSES:-}" != "1" ] || \
                    [ -z "${VLLM_WHISPER_BASE_URL:-}" ] || \
                    [ -z "${VLLM_WHISPER_MODEL:-}" ] || \
                    [ -z "${VLLM_WHISPER_REQUEST_TIMEOUT_SECONDS:-}" ] || \
                    [ -z "${VLLM_WHISPER_CONNECT_TIMEOUT_SECONDS:-}" ]; then
                    echo "$profile vllm-whisper env profile mismatch" >&2
                    exit 1
                fi
                ;;
            *)
                echo "$profile agent provider is not deployable: $STT_ENGINE_PROVIDER" >&2
                exit 1
                ;;
        esac
    )
}

session_exists() {
    tmux has-session -t "=$1" 2>/dev/null
}

start_tunnel() {
    if session_exists "$TUNNEL_SESSION"; then
        echo "tunnel supervisor is already running"
        return
    fi
    require_file "$TUNNEL_ENV"
    require_file "$CURRENT_LINK/scripts/start_ec2_tunnels.sh"
    tmux new-session -d -s "$TUNNEL_SESSION" "$CURRENT_LINK/deploy/bin/liveclass-realtime-agent-supervisor _run-tunnel"
    echo "tunnel supervisor started"
}

start_agent_instance() {
    agent_environment="$1"
    agent_env="$2"
    agent_session="$3"
    agent_command="$4"
    if session_exists "$agent_session"; then
        echo "$agent_environment agent supervisor is already running"
        return
    fi
    require_file "$COMMON_AGENT_ENV"
    require_file "$agent_env"
    require_file "$CURRENT_LINK/.venv/bin/python"
    tmux new-session -d -s "$agent_session" \
        "$CURRENT_LINK/deploy/bin/liveclass-realtime-agent-supervisor $agent_command"
    echo "$agent_environment agent supervisor started"
}

validate_prod_agent() {
    validate_agent_env_profile prod "$PROD_AGENT_ENV" \
        liveclass-realtime-stt-prod 8081
}

validate_dev_agent() {
    validate_agent_env_profile dev "$DEV_AGENT_ENV" \
        liveclass-realtime-stt-dev 8082
}

start_agents() {
    require_file "$COMMON_AGENT_ENV"
    require_file "$PROD_AGENT_ENV"
    require_file "$DEV_AGENT_ENV"
    validate_prod_agent
    validate_dev_agent
    if session_exists "$LEGACY_AGENT_SESSION"; then
        stop_session "$LEGACY_AGENT_SESSION"
        echo "stopped legacy single-agent supervisor"
    fi
    start_agent_instance prod "$PROD_AGENT_ENV" "$PROD_AGENT_SESSION" _run-agent-prod
    start_agent_instance dev "$DEV_AGENT_ENV" "$DEV_AGENT_SESSION" _run-agent-dev
}

stop_session() {
    if session_exists "$1"; then
        tmux kill-session -t "=$1"
    fi
}

show_agent_status() {
    status=0
    if session_exists "$PROD_AGENT_SESSION"; then
        echo "prod agent: running"
    else
        echo "prod agent: stopped"
        status=1
    fi
    if session_exists "$DEV_AGENT_SESSION"; then
        echo "dev agent: running"
    else
        echo "dev agent: stopped"
        status=1
    fi
    return "$status"
}

show_status() {
    status=0
    if session_exists "$TUNNEL_SESSION"; then
        echo "tunnel: running"
    else
        echo "tunnel: stopped"
        status=1
    fi
    if ! show_agent_status; then
        status=1
    fi
    return "$status"
}

stop_agents() {
    stop_session "$LEGACY_AGENT_SESSION"
    stop_session "$PROD_AGENT_SESSION"
    stop_session "$DEV_AGENT_SESSION"
}

run_agent() {
    run_agent_env="$1"
    load_agent_env "$run_agent_env"
    if [ -n "${LIVEKIT_TUNNEL_HOST:-}" ]; then
        DNS_REDIRECT_LIB="${LIVEKIT_DNS_REDIRECT_LIB:-$HOME/.local/lib/liveclass/livekit-tunnel-dns.so}"
        require_file "$DNS_REDIRECT_LIB"
        LD_PRELOAD="$DNS_REDIRECT_LIB${LD_PRELOAD:+:$LD_PRELOAD}"
        export LD_PRELOAD
    fi
    cd "$CURRENT_LINK"
    while :; do
        set +e
        "$CURRENT_LINK/.venv/bin/python" -m app.main start
        agent_status=$?
        set -e
        if [ "$agent_status" -eq 0 ]; then
            exit 0
        fi
        echo "agent exited with status $agent_status; retrying in ${RESTART_DELAY_SECONDS}s" >&2
        sleep "$RESTART_DELAY_SECONDS"
    done
}

show_agent_logs() {
    agent_environment="$1"
    agent_session="$2"
    echo "== $agent_environment agent =="
    if session_exists "$agent_session"; then
        tmux capture-pane -p -t "$agent_session:0.0" -S -200
    else
        echo "$agent_environment agent: stopped"
    fi
}

if [ "$PROD_AGENT_SESSION" = "$DEV_AGENT_SESSION" ]; then
    echo "prod and dev agent sessions must be different" >&2
    exit 1
fi

require_command tmux

case "$COMMAND" in
    _run-tunnel)
        load_env "$TUNNEL_ENV"
        while :; do
            if ! "$CURRENT_LINK/scripts/start_ec2_tunnels.sh"; then
                echo "tunnel check failed; retrying in ${RESTART_DELAY_SECONDS}s" >&2
            fi
            sleep "$RESTART_DELAY_SECONDS"
        done
        ;;
    _run-agent-prod)
        run_agent "$PROD_AGENT_ENV"
        ;;
    _run-agent-dev)
        run_agent "$DEV_AGENT_ENV"
        ;;
    start)
        start_tunnel
        start_agents
        ;;
    start-agent)
        start_agents
        ;;
    start-tunnel)
        start_tunnel
        ;;
    restart)
        stop_agents
        stop_session "$TUNNEL_SESSION"
        start_tunnel
        start_agents
        ;;
    restart-agent)
        stop_agents
        start_agents
        ;;
    restart-agent-prod)
        validate_prod_agent
        stop_session "$PROD_AGENT_SESSION"
        start_agent_instance prod "$PROD_AGENT_ENV" "$PROD_AGENT_SESSION" _run-agent-prod
        ;;
    restart-agent-dev)
        validate_dev_agent
        stop_session "$DEV_AGENT_SESSION"
        start_agent_instance dev "$DEV_AGENT_ENV" "$DEV_AGENT_SESSION" _run-agent-dev
        ;;
    stop)
        stop_agents
        stop_session "$TUNNEL_SESSION"
        ;;
    stop-agent)
        stop_agents
        ;;
    stop-agent-prod)
        stop_session "$PROD_AGENT_SESSION"
        ;;
    stop-agent-dev)
        stop_session "$DEV_AGENT_SESSION"
        ;;
    status)
        show_status
        ;;
    status-agent)
        show_agent_status
        ;;
    logs-agent)
        show_agent_logs prod "$PROD_AGENT_SESSION"
        show_agent_logs dev "$DEV_AGENT_SESSION"
        ;;
    logs-agent-prod)
        show_agent_logs prod "$PROD_AGENT_SESSION"
        ;;
    logs-agent-dev)
        show_agent_logs dev "$DEV_AGENT_SESSION"
        ;;
    logs-tunnel)
        tmux capture-pane -p -t "$TUNNEL_SESSION:0.0" -S -200
        ;;
    *)
        echo "usage: liveclass-realtime-agent-supervisor {start|start-agent|start-tunnel|restart|restart-agent|restart-agent-prod|restart-agent-dev|stop|stop-agent|stop-agent-prod|stop-agent-dev|status|status-agent|logs-agent|logs-agent-prod|logs-agent-dev|logs-tunnel}" >&2
        exit 2
        ;;
esac

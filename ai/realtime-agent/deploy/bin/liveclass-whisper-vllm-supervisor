#!/bin/sh
set -eu

COMMAND="${1:-status}"
CONFIG_DIR="${LIVECLASS_CONFIG_DIR:-$HOME/.config/liveclass}"
RUNTIME_ENV="${LIVECLASS_WHISPER_VLLM_ENV:-$CONFIG_DIR/whisper-vllm.env}"
SESSION="${LIVECLASS_WHISPER_VLLM_SESSION:-liveclass-whisper-vllm}"
RESTART_DELAY_SECONDS="${LIVECLASS_RESTART_DELAY_SECONDS:-5}"
SCRIPT_PATH="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename "$0")"

require_file() {
    if [ ! -r "$1" ]; then
        echo "required file is not readable: $1" >&2
        exit 1
    fi
}

load_runtime_env() {
    require_file "$RUNTIME_ENV"
    set -a
    # User-owned secret file using shell KEY=value syntax.
    # shellcheck disable=SC1090
    . "$RUNTIME_ENV"
    set +a
}

session_exists() {
    tmux has-session -t "=$SESSION" 2>/dev/null
}

validate_runtime_env() {
    load_runtime_env
    : "${WHISPER_VLLM_VENV:?WHISPER_VLLM_VENV is required}"
    : "${WHISPER_VLLM_MODEL_PATH:?WHISPER_VLLM_MODEL_PATH is required}"
    : "${WHISPER_VLLM_SERVED_MODEL_NAME:?WHISPER_VLLM_SERVED_MODEL_NAME is required}"
    : "${WHISPER_VLLM_PORT:?WHISPER_VLLM_PORT is required}"
    if [ "${CUDA_VISIBLE_DEVICES:-}" != "0" ]; then
        echo "Whisper vLLM runtime is restricted to GPU 0" >&2
        exit 1
    fi
    if [ "${WHISPER_VLLM_HOST:-}" != "127.0.0.1" ]; then
        echo "WHISPER_VLLM_HOST must be 127.0.0.1" >&2
        exit 1
    fi
    case "$WHISPER_VLLM_PORT" in
        *[!0-9]*|"")
            echo "WHISPER_VLLM_PORT must be numeric" >&2
            exit 1
            ;;
    esac
    if [ "$WHISPER_VLLM_PORT" -lt 1 ] || [ "$WHISPER_VLLM_PORT" -gt 65535 ]; then
        echo "WHISPER_VLLM_PORT must be between 1 and 65535" >&2
        exit 1
    fi
    if [ "${WHISPER_VLLM_DTYPE:-}" != "bfloat16" ] || \
        [ "${WHISPER_VLLM_GPU_MEMORY_UTILIZATION:-}" != "0.08" ] || \
        [ "${WHISPER_VLLM_MAX_NUM_BATCHED_TOKENS:-}" != "2048" ] || \
        [ "${WHISPER_VLLM_MAX_NUM_SEQS:-}" != "1" ]; then
        echo "Whisper vLLM runtime profile must use bfloat16, memory 0.08, batched tokens 2048, max sequences 1" >&2
        exit 1
    fi
    if [ ! -x "$WHISPER_VLLM_VENV/bin/vllm" ]; then
        echo "vLLM is not installed: $WHISPER_VLLM_VENV" >&2
        exit 1
    fi
    if [ ! -d "$WHISPER_VLLM_MODEL_PATH" ]; then
        echo "Whisper checkpoint directory does not exist: $WHISPER_VLLM_MODEL_PATH" >&2
        exit 1
    fi
}

probe_runtime() {
    load_runtime_env
    "$WHISPER_VLLM_VENV/bin/python" -c '
import json
import os
import urllib.request

host = os.environ["WHISPER_VLLM_HOST"]
port = os.environ["WHISPER_VLLM_PORT"]
url = "http://{}:{}/v1/models".format(host, port)
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
with opener.open(url, timeout=2) as response:
    payload = json.load(response)
models = {
    item.get("id")
    for item in payload.get("data", [])
    if isinstance(item, dict)
}
if os.environ["WHISPER_VLLM_SERVED_MODEL_NAME"] not in models:
    raise SystemExit("configured served model is absent from /v1/models")
'
}

run_runtime() {
    validate_runtime_env
    export CUDA_VISIBLE_DEVICES=0
    while :; do
        set +e
        "$WHISPER_VLLM_VENV/bin/vllm" serve "$WHISPER_VLLM_MODEL_PATH" \
            --host "$WHISPER_VLLM_HOST" \
            --port "$WHISPER_VLLM_PORT" \
            --served-model-name "$WHISPER_VLLM_SERVED_MODEL_NAME" \
            --dtype "${WHISPER_VLLM_DTYPE:-bfloat16}" \
            --gpu-memory-utilization "${WHISPER_VLLM_GPU_MEMORY_UTILIZATION:-0.08}" \
            --max-num-batched-tokens "${WHISPER_VLLM_MAX_NUM_BATCHED_TOKENS:-2048}" \
            --max-num-seqs "${WHISPER_VLLM_MAX_NUM_SEQS:-1}"
        runtime_status=$?
        set -e
        echo "vLLM runtime exited with status $runtime_status; retrying in ${RESTART_DELAY_SECONDS}s" >&2
        sleep "$RESTART_DELAY_SECONDS"
    done
}

case "$COMMAND" in
    _run)
        run_runtime
        ;;
    start)
        command -v tmux >/dev/null 2>&1 || {
            echo "required command is missing: tmux" >&2
            exit 1
        }
        validate_runtime_env
        if session_exists; then
            echo "Whisper vLLM runtime is already running"
            exit 0
        fi
        tmux new-session -d -s "$SESSION" "$SCRIPT_PATH _run"
        echo "Whisper vLLM runtime supervisor started"
        ;;
    restart)
        if session_exists; then
            tmux kill-session -t "=$SESSION"
        fi
        "$SCRIPT_PATH" start
        ;;
    stop)
        if session_exists; then
            tmux kill-session -t "=$SESSION"
        fi
        ;;
    status)
        if ! session_exists; then
            echo "Whisper vLLM runtime: stopped"
            exit 1
        fi
        probe_runtime
        echo "Whisper vLLM runtime: ready"
        ;;
    health)
        probe_runtime
        ;;
    logs)
        if ! session_exists; then
            echo "Whisper vLLM runtime: stopped"
            exit 1
        fi
        tmux capture-pane -p -t "$SESSION:0.0" -S -200
        ;;
    *)
        echo "usage: liveclass-whisper-vllm-supervisor {start|restart|stop|status|health|logs}" >&2
        exit 2
        ;;
esac

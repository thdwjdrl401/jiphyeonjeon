# 노트북에서 실시간 STT를 서빙할 때 쓰는 프로파일.
#
# 전용 GPU 서버가 사라져 STT를 노트북 GPU로 내렸다. 서버 시절과 달라지는 것은 두 가지다:
#   1) 동시 처리량 — 8GB VRAM에는 warm 프로세스를 하나만 둔다(서버는 12개였다).
#   2) LiveKit 연결 — 공개 도메인에 직접 붙는다. 옛 구조는 EC2가 인바운드를 닫아 둔 탓에
#      SSH 터널 + LD_PRELOAD DNS shim + TURN relay-only 우회가 필요했는데, 이제 시그널링이
#      공개 WSS라 그 셋이 전부 사라진다. 미디어도 UDP로 직접 간다.
#
# 남는 터널은 Redis 하나다. 자막을 쓰는 스트림이 배포 호스트의 루프백에만 열려 있다:
#   ssh -N -L 6390:127.0.0.1:6390 lazy
# (노트북이 같은 LAN에 있으면 그것도 필요 없다 — 호스트 LAN 주소를 직접 쓰면 된다.)

# ── STT 엔진 ───────────────────────────────────────────────────────────────
STT_ENGINE_PROVIDER=nemotron

# HuggingFace 모델 ID를 그대로 쓴다. 서버 시절에는 로컬 경로였지만 그 파일은 그 호스트에만
# 있었다. 파인튜닝 체크포인트(.nemo)를 확보했다면 provider를 nemotron-nemo로 바꾸고
# NEMO_RUNTIME_MODEL_PATH를 지정한다 — 한국어 정확도가 그쪽이 높다.
ASR_MODEL_ID=nvidia/nemotron-3.5-asr-streaming-0.6b
ASR_LANGUAGE=ko

# RTX 4070 Laptop 8GB 기준. 프로세스당 약 3GB를 쓰므로 하나만 상주시킨다.
# 늘리면 동시 강의를 더 받지만 VRAM이 먼저 바닥난다.
STT_MAX_ACTIVE_JOBS=1
STT_NUM_IDLE_PROCESSES=1
CUDA_VISIBLE_DEVICES=0

# ── 연결 ───────────────────────────────────────────────────────────────────
# 공개 시그널링. 터널도 DNS shim도 필요 없다.
LIVEKIT_URL=wss://jiphyeonjeon.thdwjdrl.com:7443
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SSH -L로 당겨온 배포 호스트의 Redis. 같은 LAN이면 redis://<호스트LAN주소>:6390/0 로 직결.
REDIS_URL=redis://127.0.0.1:6390/0
CAPTION_STREAM_KEY=ai:captions:live

# ── 에이전트 신원 ──────────────────────────────────────────────────────────
# 백엔드가 이 이름으로 dispatch한다(application.yml의 LIVEKIT_AGENT_NAME과 같아야 한다).
STT_AGENT_NAME=liveclass-realtime-stt-prod
STT_HEALTH_HOST=127.0.0.1
STT_HEALTH_PORT=8081

SESSION_LEASE_TTL_SECONDS=30
SPRING_STATUS_CALLBACK_ENABLED=false
LOG_LEVEL=INFO

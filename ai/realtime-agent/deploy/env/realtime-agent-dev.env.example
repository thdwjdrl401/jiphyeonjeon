# development realtime-agent: EC2 dev Redis via SSH local forward.
LIVEKIT_URL=wss://<livekit-host>:7443
# TLS hostname을 URL에 유지한 채 loopback SSH tunnel로 해석할 hostname.
LIVEKIT_TUNNEL_HOST=<livekit-host>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
LIVEKIT_TURN_URL=turn:127.0.0.1:3478?transport=tcp
LIVEKIT_TURN_SECRET=<coturn-rest-auth-secret>
REDIS_URL=redis://:<dev-redis-password>@127.0.0.1:4000/0
CUDA_VISIBLE_DEVICES=0
STT_AGENT_NAME=liveclass-realtime-stt-dev
STT_HEALTH_HOST=127.0.0.1
STT_HEALTH_PORT=8082
STT_ENGINE_PROVIDER=nemotron
# production 12-slot worker와 GPU0를 공유하므로 개발 기본 용량은 1로 제한한다.
STT_MAX_ACTIVE_JOBS=1
STT_NUM_IDLE_PROCESSES=1
ASR_MODEL_ID=/home/<user>/models/nemotron-3.5-asr-streaming-0.6b

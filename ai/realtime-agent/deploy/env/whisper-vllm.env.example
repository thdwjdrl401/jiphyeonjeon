# GPU0 loopback Whisper vLLM model owner.
CUDA_VISIBLE_DEVICES=0
WHISPER_VLLM_VENV=/home/<user>/.local/share/liveclass/whisper-vllm/vllm-0.11.2-cu128
# 첫 적용 대상은 내려받은 openai/whisper-large-v3 기본 모델이다.
# 이후 LoRA 결과를 승격할 때는 adapter 원본이 아니라 vLLM load smoke를 통과한
# processor 포함 merged full checkpoint 경로로 교체한다.
WHISPER_VLLM_MODEL_PATH=/home/<user>/ai/models/whisper-large-v3
WHISPER_VLLM_SERVED_MODEL_NAME=liveclass-whisper-large-v3
WHISPER_VLLM_HOST=127.0.0.1
WHISPER_VLLM_PORT=18083
WHISPER_VLLM_DTYPE=bfloat16
WHISPER_VLLM_GPU_MEMORY_UTILIZATION=0.08
WHISPER_VLLM_MAX_NUM_SEQS=1

# GPU0 loopback Qwen3-ASR vLLM model owner.
CUDA_VISIBLE_DEVICES=0
WHISPER_VLLM_VENV=/home/<user>/.local/share/liveclass/qwen3-asr-vllm/vllm-0.14.0-cu128
# Qwen3-ASR architecture 등록을 위해 qwen-asr-serve를 사용한다.
WHISPER_VLLM_SERVE_COMMAND=qwen-asr-serve
# 첫 적용 대상은 내려받은 Qwen3-ASR 1.7B 기본 모델이다.
# 이후 LoRA 결과를 승격할 때는 adapter 원본이 아니라 vLLM load smoke를 통과한
# processor 포함 merged full checkpoint 경로로 교체한다.
WHISPER_VLLM_MODEL_PATH=/home/<user>/ai/models/qwen3-asr-1.7b
WHISPER_VLLM_SERVED_MODEL_NAME=liveclass-qwen3-asr-1.7b
WHISPER_VLLM_HOST=127.0.0.1
WHISPER_VLLM_PORT=18083
WHISPER_VLLM_DTYPE=bfloat16
WHISPER_VLLM_GPU_MEMORY_UTILIZATION=0.10
WHISPER_VLLM_MAX_NUM_BATCHED_TOKENS=2048
WHISPER_VLLM_MAX_NUM_SEQS=1

# production realtime-agent profile. 공통값은 realtime-agent-common.env에서 로드한다.
# EC2 loopback에만 publish된 운영 application Redis를 SSH local forward로 사용한다.
REDIS_URL=redis://127.0.0.1:6390/0
CUDA_VISIBLE_DEVICES=0
STT_AGENT_NAME=liveclass-realtime-stt-prod
STT_HEALTH_PORT=8081
STT_ENGINE_PROVIDER=nemotron
STT_MAX_ACTIVE_JOBS=12
STT_NUM_IDLE_PROCESSES=12
ASR_MODEL_ID=/home/<user>/models/nemotron-3.5-asr-streaming-0.6b

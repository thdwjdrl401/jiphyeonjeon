# Production profile for the tuned full-trained Nemotron checkpoint.
REDIS_URL=redis://127.0.0.1:6390/0
STT_AGENT_NAME=liveclass-realtime-stt-prod
STT_HEALTH_PORT=8081
STT_ENGINE_PROVIDER=nemotron-nemo
STT_MAX_ACTIVE_JOBS=5
STT_NUM_IDLE_PROCESSES=5
NEMO_RUNTIME_BASE_URL=http://127.0.0.1:18084/v1
NEMO_RUNTIME_MODEL=liveclass-nemotron-3.5-tuned
NEMO_RUNTIME_REQUEST_TIMEOUT_SECONDS=20
NEMO_RUNTIME_CONNECT_TIMEOUT_SECONDS=2

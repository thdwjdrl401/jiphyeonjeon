# Opt-in production profile. 첫 적용은 openai/whisper-large-v3 기본 모델 alias를 사용한다.
REDIS_URL=redis://127.0.0.1:6390/0
STT_AGENT_NAME=liveclass-realtime-stt-prod
STT_HEALTH_PORT=8081
STT_ENGINE_PROVIDER=vllm-whisper
STT_MAX_ACTIVE_JOBS=1
STT_NUM_IDLE_PROCESSES=1
VLLM_WHISPER_BASE_URL=http://127.0.0.1:18083/v1
VLLM_WHISPER_MODEL=liveclass-whisper-large-v3
VLLM_API_KEY=
VLLM_WHISPER_REQUEST_TIMEOUT_SECONDS=20
VLLM_WHISPER_CONNECT_TIMEOUT_SECONDS=2

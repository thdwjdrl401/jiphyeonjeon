LIVEKIT_URL=wss://livekit.example
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
STT_AGENT_NAME=liveclass-realtime-stt

# stub is for local verification only. Production choices are openai-realtime or nemotron.
STT_ENGINE_PROVIDER=stub
STT_MAX_ACTIVE_JOBS=1
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low
ASR_MODEL_ID=nvidia/nemotron-3.5-asr-streaming-0.6b
ASR_LANGUAGE=ko-KR

# Application Redis, not the Redis instance owned by LiveKit.
REDIS_URL=redis://localhost:6379/0
CAPTION_STREAM_KEY=ai:captions:live
SESSION_LEASE_TTL_SECONDS=30

# ROOM_DELETED starts one shared 12-second deadline. The 13-second validation ceiling leaves
# headroom before livekit-agents 1.6.6 cancels the user entrypoint after 15 seconds.
STT_SHUTDOWN_TIMEOUT_SECONDS=12
STT_DRAIN_TIMEOUT_SECONDS=7
STT_CLEANUP_TIMEOUT_SECONDS=1
CAPTION_PUBLISH_TIMEOUT_SECONDS=1.25
REDIS_OPERATION_TIMEOUT_SECONDS=1

# Disabled until Spring adopts the AI-side candidate callback contract.
SPRING_STATUS_CALLBACK_ENABLED=false
SPRING_STATUS_CALLBACK_URL=
AI_CALLBACK_SECRET=
SPRING_STATUS_CALLBACK_TIMEOUT_SECONDS=0.75
SPRING_STATUS_CALLBACK_ATTEMPTS=2

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm --prefix frontend run lint:*)",
      "Bash(npm --prefix frontend run build:*)",
      "Bash(cd backend && ./gradlew test:*)",
      "Bash(cd backend && ./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot (Backend)",
      "request": "launch",
      "mainClass": "com.liveclass.LiveClassApplication",
      "projectName": "liveclass",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "type": "node-terminal",
      "name": "Frontend (Vite dev)",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (BE + FE)",
      "configurations": ["Spring Boot (Backend)", "Frontend (Vite dev)"],
      "stopAll": true
    }
  ]
}

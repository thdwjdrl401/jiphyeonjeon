# 프로덕션(EC2) 환경변수 템플릿 — 복사해서 .env.prod 로 채운다 (.env.prod는 커밋 금지).
#   cp .env.prod.example .env.prod
# docker-compose.prod.yml 이 --env-file .env.prod 로 읽는다.

POSTGRES_USER=liveclass
POSTGRES_PASSWORD=change-me-strong-password   # ← 운영은 반드시 강한 값으로 변경
POSTGRES_DB=liveclass

# 에셋 스토리지(MinIO) — 썸네일·프로필·강의자료 presigned 업로드. backend가 같은 값을 access/secret로 쓴다.
MINIO_ROOT_USER=liveclass-assets              # ← 운영은 변경 권장
MINIO_ROOT_PASSWORD=change-me-strong-password # ← 운영은 반드시 강한 값으로 변경
# (선택) 기본값 쓰면 생략 가능: 버킷 liveclass-assets · region us-east-1
# ASSET_STORAGE_BUCKET=liveclass-assets
# ASSET_STORAGE_REGION=us-east-1

# RabbitMQ(AI 배치 잡 큐, ADR-0036). prod 전용 브로커. backend가 SPRING_RABBITMQ_*로 붙는다.
RABBITMQ_USER=liveclass
RABBITMQ_PASSWORD=change-me-strong-password   # ← 운영은 반드시 강한 값으로 변경

# 인프라 포트 공개(docker-compose.expose.yml)로 로컬 개발자가 EC2 Redis/PG에 붙을 때만 필요.
# Redis requirepass — 노출된 6379를 보호. 강한 값으로. (평소 prod 배포엔 불필요)
EC2_REDIS_PASSWORD=

# 자료(PPTX) 임베딩 스위치(ADR-0036). true여야 자료 연결 시 임베딩 잡이 발행돼 AI가 근거로 쓸 수 있다.
# false(기본)면 자료는 연결되고 상태도 READY가 되지만 임베딩이 없어, AI 질의가 늘 "근거 없음"으로 답한다.
MATERIAL_EMBEDDING_ENABLED=true

# 판서 해석(ADR-0054, CONTRACT §3-6e) — 손그림을 mermaid/LaTeX로 옮길 때 backend가 GMS를 직접 부른다.
# ai-api를 거치지 않는다: 이 호출에는 검색도 임베딩도 자막 컨텍스트도 없어 파이썬이 할 일이 없다.
#
# 비워 두면 기능만 꺼진다(강사가 "정리"를 누르면 502). 기동은 막지 않으므로 강의는 그대로 돌아간다.
# ai-api의 GMS_API_KEY(.env.ai-prod)와 **같은 값을 복사하지 않는다** — 한 값을 두 파일에 적으면
# 회전할 때 한쪽만 바뀌어 어긋난다. 같은 키를 쓸지는 운영이 정하고, 여기엔 여기 값만 둔다.
ANNOTATION_AI_API_KEY=
# 선택 — 기본값(gpt-4.1)을 쓰면 생략 가능. 비전+툴콜을 모두 지원하는 모델이어야 한다.
# ANNOTATION_AI_MODEL=gpt-4.1

# 운영 콘솔(Egress 관리 등) 접근을 허용할 계정 이메일 — 콤마로 구분한다.
# 비워 두면 관리자가 없다(콘솔은 403). 회원가입 역할이 아니라 로그인 시 기존 계정에 ROLE_ADMIN을
# 덧입히는 방식이라, 목록을 바꾸면 해당 사용자는 재로그인해야 반영된다.
SECURITY_ADMIN_EMAILS=

# AI 강의 노트 소비(CONTRACT §3-4a). 기본 꺼짐 — 켜면 강의실 "실시간 노트" 탭이 실제 노트로 채워진다.
# 켜는 순간 그동안 Redis 스트림에 쌓인 이벤트를 처음(0-0)부터 읽으므로 지난 세션 노트가 먼저 들어온다.
# docker-compose.prod.yml의 environment에도 같은 이름이 있어야 컨테이너까지 전달된다.
LECTURE_NOTE_CONSUMER_ENABLED=false

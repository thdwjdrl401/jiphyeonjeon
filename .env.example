# 개발 backbone 환경변수 — 복사해서 .env 로 쓰기 (`.env`는 git 무시).
# 로컬 개발 전용 값. 운영/원격 호스트는 별도 시크릿 관리.

POSTGRES_USER=liveclass
POSTGRES_PASSWORD=liveclass
POSTGRES_DB=liveclass

# 녹화강의 batch STT는 명시적으로 opt-in한다. GMS 키는 브라우저/백엔드 응답에 노출하지 않는다.
RECORDED_STT_ENABLED=false
RECORDED_STT_SOURCE_SECRET=dev-recorded-stt-source-secret
RECORDED_STT_CALLBACK_SECRET=dev-recorded-stt-callback-secret
GMS_API_KEY=

# Redis는 로컬 dev라 비밀번호 없음. (운영은 requirepass 별도)

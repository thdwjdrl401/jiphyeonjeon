# remote 프로필 시크릿 — 로컬 backend를 EC2 dev 인프라에 붙일 때 (docker-compose.dev-infra.yml).
#   cp .env.remote.example .env.remote   # (.env.remote는 git 무시)
# VSCode "Spring Boot (Backend · EC2 infra)" 런치가 envFile로 읽거나,
# 터미널: `set -a; . ./.env.remote; set +a` 후 `SPRING_PROFILES_ACTIVE=remote ./gradlew bootRun`.

EC2_INFRA_HOST=jiphyeonjeon.thdwjdrl.com
EC2_PG_PORT=5433
EC2_REDIS_PORT=4000
EC2_RABBITMQ_PORT=4001

# EC2 dev PG/Redis 접속 시크릿 — EC2 /etc/liveclass/.env.dev 의 값과 일치해야 한다.
POSTGRES_USER=liveclass
POSTGRES_DB=liveclass
POSTGRES_PASSWORD=
EC2_REDIS_PASSWORD=

# EC2 dev RabbitMQ (임베딩 잡 큐) — EC2 /etc/liveclass/.env.dev 의 RABBITMQ_USER/PASSWORD 와 일치
RABBITMQ_USER=liveclass
RABBITMQ_PASSWORD=

# EC2 dev MinIO (에셋 스토리지) — secret은 EC2 /etc/liveclass/.env.dev 의 MINIO_ROOT_PASSWORD 와 일치
ASSET_STORAGE_ACCESS_KEY=liveclass
ASSET_STORAGE_SECRET_KEY=
# ASSET_STORAGE_ENDPOINT=http://43.201.249.3:9090   # 기본값 있음, 바꿀 때만

# EC2 dev MinIO (녹화 스토리지, recordings 버킷) — 위 ASSET_STORAGE_SECRET_KEY와 같은 값
EGRESS_S3_ACCESS_KEY=liveclass
EGRESS_S3_SECRET=

# LiveKit — EC2 /etc/liveclass/livekit/CREDENTIALS.txt 의 값과 일치해야 한다.
# 없으면 application.yml의 dev 더미(devkey)로 떨어져 Egress 시작이 401로 실패한다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 백엔드가 LiveKit 서버 API를 부를 주소. 브라우저 접속용(LIVEKIT_URL)과 다르다.
LIVEKIT_API_URL=https://jiphyeonjeon.thdwjdrl.com:7443
# 동기 Room/Egress 제어 한 번의 전체 제한 시간. 종료 요청이 외부 API에서 무기한 대기하지 않게 한다.
LIVEKIT_CONTROL_TIMEOUT=10s

# 판서 해석(ADR-0054, CONTRACT §3-6e) — 손그림을 mermaid/LaTeX로 옮길 때 backend가 GMS를 직접 부른다.
# 없으면 그 기능만 꺼진다(강사가 "정리"를 누르면 502). 판서·강의 자체는 그대로 동작하므로,
# 판서 정리를 로컬에서 볼 일이 없다면 비워 둬도 된다.
# 값은 EC2 /etc/liveclass/.env.ai-prod 의 GMS_API_KEY 와 같은 게이트웨이 키다.
ANNOTATION_AI_API_KEY=

# 라이브 AI 질문(RAG)을 받는 ai-api. 기본값은 compose 서비스명(http://ai-api:8010)이라
# 로컬에서 띄운 JVM은 이름을 풀지 못한다 → remote에서는 반드시 지정해야 한다.
# EC2의 dev ai-api는 18010으로 게시돼 있어 SSH 터널 없이 이 주소로 바로 붙는다.
AI_API_BASE_URL=http://jiphyeonjeon.thdwjdrl.com:18010
# ai-api가 X-Internal-Signature를 검증할 공유 시크릿(ADR-0023). backend와 ai-api가 같아야 하며
# 다르면 요청이 401로 거절된다. 값은 EC2 /etc/liveclass/.env.ai-dev 의 AI_INTERNAL_SECRET 과 같다.
AI_INTERNAL_SECRET=

# Egress 합성 템플릿(수강생이 보는 화면 그 자체) — 비우면 LiveKit 기본 grid로 합성돼
# 강사 화면과 카메라 위치·미러가 어긋난다. Egress 헤드리스 Chrome이 여는 주소라
# 로컬 vite(:8083)는 넣어도 원격 워커가 못 연다 → 배포된 프론트를 가리켜야 한다.
#
# <b>정본 도메인을 그대로 적는다.</b> 옛 도메인(jiphyeonjeon.thdwjdrl.com)을 적으면 nginx가 301로
# 돌려보내고, Egress 크롬은 녹화를 시작할 때마다 그 왕복을 한 번 더 탄다. 크롬 기동에는
# 이미 20초라는 고정 상한(chromedp)이 걸려 있어 여유를 깎을 이유가 없다.
EGRESS_TEMPLATE_BASE_URL=https://jiphyeonjeon.thdwjdrl.com/egress/stage

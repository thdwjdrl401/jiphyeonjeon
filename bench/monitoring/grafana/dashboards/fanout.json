{
  "uid": "fanout-bench",
  "title": "알림 팬아웃·발송",
  "description": "100만 명 팬아웃과 웹푸시 발송. 구간마다 무엇이 막는지가 CPU 그래프에서 갈린다.",
  "tags": [
    "liveclass",
    "notification"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "title": "컨테이너 CPU — 구간마다 병목이 자리를 바꾼다",
      "description": "앞의 짧은 봉우리가 팬아웃(Postgres)이고, 뒤의 긴 고원이 발송(앱)이다. 노드를 나눈 이유가 이 그림이다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"liveclass-bench-postgres-1\"}[30s]))*100",
          "legendFormat": "Postgres",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"liveclass-bench-app-1\"}[30s]))*100",
          "legendFormat": "앱",
          "refId": "B"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"liveclass-bench-rabbitmq-1\"}[30s]))*100",
          "legendFormat": "RabbitMQ",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Postgres"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E9E5B"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "앱"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2D6FD4"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RabbitMQ"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D97B29"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 1,
      "title": "초당 삽입 행 수 — 알림 하나에 두 행을 쓴다",
      "description": "알림 행(굵은 선)과 중복 제거 등록표(파선)가 완전히 포개져 있다. 파선이 굵은 선 위를 정확히 따라가는 것이 요점이다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_user_tables_n_tup_ins{relname=~\"notification_p20.*\"}[30s]))",
          "legendFormat": "알림 행",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_user_tables_n_tup_ins{relname=\"notification_dedupe\"}[30s]))",
          "legendFormat": "중복 제거 등록표",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pg_stat_user_tables_n_tup_ins{relname=~\"notification_push_progress.*\"}[30s]))",
          "legendFormat": "발송 진행 기록",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "custom": {
            "lineWidth": 2.5,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "알림 행"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E9E5B"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "중복 제거 등록표"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C2185B"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2.5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "발송 진행 기록"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2D6FD4"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2.5
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "큐 깊이 — 어디가 밀리는가",
      "description": "팬아웃 큐는 갈래 수만큼만 떠 있다(직렬 체인). 푸시 큐는 21초 만에 다 쌓이고 발송이 12분에 걸쳐 비운다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=\"notification.fanout\"}",
          "legendFormat": "팬아웃 큐",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_queue_messages{queue=\"notification.push\"}",
          "legendFormat": "푸시 큐",
          "refId": "B"
        },
        {
          "expr": "sum(rabbitmq_queue_messages{queue=~\".*dlq\"})",
          "legendFormat": "DLQ",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2.5,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "팬아웃 큐"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E9E5B"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3.5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "푸시 큐"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2D6FD4"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DLQ"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C62828"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "JVM 힙 — 슬라이싱이 지키는 자리",
      "description": "수신자를 조각으로 끊어 읽으므로 힙은 수신자 수와 무관하게 평평하다. 한 번에 다 읽으면 여기가 100만 명만큼 부푼다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [

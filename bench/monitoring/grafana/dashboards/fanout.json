{
  "uid": "fanout-bench",
  "title": "알림 파이프라인",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "Asia/Seoul",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "서비스 상태",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "컨테이너 CPU",
      "type": "timeseries",
      "description": "코어 1개를 100%로 본다. 물리 4코어이므로 합이 400%까지 간다.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"liveclass-bench-.*\"}[1m])) by (name) * 100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "컨테이너 메모리 (한계 대비)",
      "type": "timeseries",
      "description": "working set 기준. 컨테이너를 다시 만들면 id 가 바뀌므로 이름으로 묶는다. 정확한 값은 Postgres cgroup 패널을 본다.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (name) ((container_memory_working_set_bytes{name=~\"liveclass-bench-.*\"} and on(id) (container_last_seen{name=~\"liveclass-bench-.*\"} > time() - 30)) / on(id) group_left container_spec_memory_limit_bytes{name=~\"liveclass-bench-.*\"} * 100)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Postgres",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "cgroup 메모리 (커널 값 · 50ms 최고 수위)",
      "type": "timeseries",
      "description": "cAdvisor 는 이 커널에서 memory.events 를 안 내보내고 급등도 놓친다. cgroup 파일을 50ms 로 직접 읽는다.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "bench_cgroup_memory_peak_bytes{container=\"liveclass-bench-postgres-1\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "bench_cgroup_memory_anon_peak_bytes{container=\"liveclass-bench-postgres-1\"}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "bench_cgroup_memory_current_bytes{container=\"liveclass-bench-postgres-1\"}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "bench_cgroup_memory_limit_bytes{container=\"liveclass-bench-postgres-1\"}",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "pointSize": 4
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "총 최고 수위"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E67E22"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "익명 최고 수위"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8E44AD"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "총 현재"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7F8C8D"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 8
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]

# true: 모든 데이터 서비스가 통합 mock 구현체를 사용하며 /api 요청을 차단합니다.
# false: 모든 데이터 서비스가 HTTP 구현체를 사용합니다(미구현 오류도 노출).
# 설정하지 않으면 개발에서는 true, 프로덕션 빌드에서는 false입니다(테스트는 항상 mock).
VITE_USE_MOCK_API=true
# VITE_USE_MOCK_API=false

# 브라우저가 접속할 EC2 LiveKit 시그널링(WSS) 주소입니다.
# API key/secret은 프론트에 두지 않고 백엔드에서 토큰 서명에만 사용합니다.
VITE_LIVEKIT_URL=wss://jiphyeonjeon.thdwjdrl.com:7443

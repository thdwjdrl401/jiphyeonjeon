        <mxCell id="e12_22" value="인증서 볼륨 공유 (읽기 전용)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="도메인이 하나뿐이고 DNS 콘솔 권한이 없어 서브도메인 대신 포트로 분리했다. 미디어 스택은 SFU 가 UDP 포트를 직접 잡아야 해서 도커 NAT 를 우회한다.&lt;br&gt;&lt;br&gt;두 스택은 라이프사이클이 분리돼 있다 — 앱을 재배포해도 라이브 세션이 끊기지 않는다. 결합은 인증서 파일 하나뿐이고 발급 소유권은 앱 스택에 있다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="940" height="110" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>

        <mxCell id="e6" value="&lt;b&gt;로스터 API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;GET .../enrollments&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1EDF4;strokeColor=#1D4E6F;strokeWidth=2;fontColor=#0F1B2A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="220" height="56" as="geometry"/></mxCell>

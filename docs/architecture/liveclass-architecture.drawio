        <mxCell id="e9_17" value="⑦" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="r7" target="r8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9_18" value="⑧ 미착수" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="r6" target="r9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9_19" value="⑨ 권한 검증 후 manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="r9" target="r10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9_20" value="⑩ 세그먼트 직접 수신" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="r10" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="여기까지는 돈다 — 세션이 끝나면 Egress 가 녹화를 올리고 video_asset 이 상태를 추적하며 카탈로그가 '다시보기 있음'을 표시한다.&lt;br&gt;&lt;br&gt;남은 것은 재생이다. nginx secure_link 대신 presigned 로 통일하는 쪽을 제안한다 — manifest 만 Spring 이 프록시하며 세그먼트 URL 을 presigned 로 재작성하면 바이트는 여전히 스토리지 직결이고 S3 로 옮겨도 그대로 동작한다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="940" height="120" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>

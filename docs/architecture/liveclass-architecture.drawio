        <mxCell id="r9" value="&lt;b&gt;재생 API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;GET /api/lessons/{id}/playback&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="210" height="56" as="geometry"/></mxCell>

        <mxCell id="e13_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k1" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k1" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k2" target="k4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k3" target="k5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k3" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k4" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="k5" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="화살표는 의존 방향이다. 접근은 &amp;lt;module&amp;gt;.api 공개면으로만 — 남의 domain·repository 직접 호출 금지. 순환 금지. 위반은 리뷰어가 아니라 ModularityTests 가 빌드에서 잡는다.&lt;br&gt;&lt;br&gt;포트는 필요한 모듈만 만든다 — 열 개 중 .api 를 가진 건 여섯 개이고 curriculum 은 유입이 없어 포트가 없다. 이 게이트가 실제로 잡은 것: video→live.config 결합, CatalogService 계층 역전, live→curriculum 순환." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="940" height="120" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>
  <diagram id="dg14" name="14 · 스키마 소유권">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="q1" value="&lt;b&gt;Spring · core-api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;Flyway&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4F2EB;strokeColor=#2C7A5B;fontColor=#0F1B2A;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="q2" value="&lt;b&gt;Python · worker / api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;Alembic · CP2~&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="q3" value="&lt;b&gt;스키마 core&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;app_user · curriculum · section · lesson · live_session · enrollment · asset · chat_message · outbox · inbox · 자막 게시본&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#F8EFDD;strokeColor=#A96F16;fontColor=#0F1B2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="q4" value="&lt;b&gt;스키마 ai&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;document_chunk · chunk_embedding · job_run · model_run — 네 개뿐&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#F8EFDD;strokeColor=#A96F16;fontColor=#0F1B2A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="q5" value="&lt;b&gt;이벤트 버스&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;outbox → 큐 → inbox&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="460" y="280" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="e14_6" value="write 독점" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="q1" target="q3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14_7" value="write 독점" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="q2" target="q4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14_8" value="읽기 — chunking 원본" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="q4" target="q3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14_9" value="AI 산출물은 이 경로로만" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="q5" target="q3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="q4" target="q5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="소유 기준은 write-owner — 런타임에 그 행을 INSERT/UPDATE 하는 서비스가 갖는다.&lt;br&gt;&lt;br&gt;벡터 인덱스를 ai 가 갖는 이유: Python 이 임베딩(쓰기)과 검색(읽기) 양쪽이라, core 로 빼면 수천 청크의 벡터를 이벤트로 실어 나르고 검색이 크로스플레인이 된다.&lt;br&gt;읽기는 grant 로 서로 허용, 쓰기는 절대 교차 없음. 스키마를 넘는 FK 없이 논리 참조 + 앱 검증." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="80" y="460" width="940" height="120" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>
</mxfile>

        <mxCell id="t2" value="&lt;b&gt;LiveKit SFU&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;방당 1회 분기&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4F2EB;strokeColor=#2C7A5B;fontColor=#0F1B2A;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="170" width="170" height="56" as="geometry"/></mxCell>

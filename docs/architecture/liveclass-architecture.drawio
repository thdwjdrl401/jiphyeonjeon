      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="g1" value="&lt;b&gt;학생&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;질문&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C7B;fontColor=#0F1B2A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="56" as="geometry"/></mxCell>

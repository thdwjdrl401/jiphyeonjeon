        <mxCell id="e11_17" value="임베딩 적재" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="g6" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="Python 은 외부에 노출되지 않는다 — 권한·정책·비용 한도를 Spring 이 먼저 판정하고 검증된 scope 만 넘긴다.&lt;br&gt;&lt;br&gt;근거가 없으면 답을 지어내지 않고 INSUFFICIENT_EVIDENCE 를 돌려준다. 모든 답변에 citation 을 붙인다. 선행 조건 — 자료를 레슨에 붙이는 API(탭 08)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="940" height="110" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>

        <mxCell id="t5" value="&lt;b&gt;Redis Stream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;fast-path · 유실 허용&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="t6" value="&lt;b&gt;core-api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;consume → core 영속&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="t7" value="&lt;b&gt;학생 화면&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;WS 자막&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="280" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="t8" value="&lt;b&gt;녹화본 2-pass&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6C7B'&gt;유실 구간 복구&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF1F4;strokeColor=#94A3AF;fontColor=#43505C;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="e10_9" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10_10" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10_11" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10_12" value="④ partial · final" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="t3" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10_13" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10_14" value="⑥ 지평선 뒤 교정본" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="t6" target="t7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10_15" value="⑦ 사후 보정" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="t8" target="t6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="원본 자막의 소유자는 Spring 이다 — agent 는 스트림에 흘리기만 하고 영속은 core 가 한다. 그래서 자막은 원본·게시본 모두 core 스키마에 있고 Python 은 chunking 을 위해 읽기만 한다.&lt;br&gt;&lt;br&gt;미정 — 지평선의 길이(N초)와 확정 선언 주체. 정해지지 않으면 프론트는 렌더 정책을, 백엔드는 영속 시점을 정할 수 없다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="940" height="110" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>

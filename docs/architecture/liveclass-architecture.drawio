        <mxCell id="e8_16" value="⑦" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="u5" target="u6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8_17" value="⑧ HEAD 로 실제 확인" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="u6" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8_18" value="⑨ UPLOADED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="u6" target="u7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8_19" value="주기 정리" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="u8" target="u7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8_20" value="여기가 끊겨 있다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="u7" target="u9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="클라이언트가 보낸 크기·타입을 믿지 않는다 — 완료 시 스토리지에 직접 물어 실제 값을 확인한다.&lt;br&gt;&lt;br&gt;끊긴 지점: 업로드는 되지만 자료를 레슨에 붙이는 API 가 없어 material_asset 이 비어 있다. CP3 RAG 의 입력이 여기서 막힌다. 프론트 목은 multipart 로 파일을 직접 보내는데, 실제 API 는 이 presigned 2단계를 따라야 한다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="940" height="120" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>

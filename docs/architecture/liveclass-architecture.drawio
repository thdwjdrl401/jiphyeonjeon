        <mxCell id="e5_9" value="① 신청" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5_10" value="② 즉시형" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5_11" value="③ 승인형" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="e2" target="e4"><mxGeometry relative="1" as="geometry"/></mxCell>

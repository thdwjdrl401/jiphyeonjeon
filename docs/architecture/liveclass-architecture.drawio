        <mxCell id="e11_14" value="⑥ 중계 · 근거 없으면 INSUFFICIENT_EVIDENCE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9DAAB6;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;dashed=1;" edge="1" parent="1" source="g2" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e5_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="e3" target="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="e4" target="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5_16" value="⑥ 상태 전이" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6C7B;strokeWidth=1.5;fontSize=10;fontColor=#4A5A6B;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="e7" target="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n1" value="@Version 이 있는 이유 — 승인과 학생의 자진 해지가 동시에 들어오면 갱신 하나가 사라져 해지한 학생이 ACTIVE 로 남을 수 있다. 충돌은 전역 핸들러가 409 로 바꾼다.&lt;br&gt;&lt;br&gt;수강 상태는 라이브 입장·다시보기 접근의 게이트다(탭 06·09). 이름 검색(q)은 크로스모듈 조인이라 보류." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4A5A6B;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="940" height="110" as="geometry"/></mxCell>
      </root></mxGraphModel>
    </diagram>

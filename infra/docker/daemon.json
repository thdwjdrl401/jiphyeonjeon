{
  "builder": {
    "gc": {
      "enabled": true,
      "policy": [
        { "keepStorage": "20GB", "filter": ["unused-for=168h"] },
        { "keepStorage": "40GB", "all": true }
      ]
    }
  },
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "50m",
    "max-file": "5"
  },
  "live-restore": true
}

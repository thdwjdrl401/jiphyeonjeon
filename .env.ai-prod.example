# AI 서비스(ai-worker, ai-api) 환경변수 템플릿 — 복사해서 .env.ai-prod 로 채운다 (.env.ai-prod는 커밋 금지).
#   cp .env.ai-prod.example .env.ai-prod
# docker-compose.ai-prod.yml이 --env-file .env.prod --env-file .env.ai-prod 로 읽는다.
# POSTGRES_DB, RABBITMQ_USER, RABBITMQ_PASSWORD는 .env.prod에 있으므로 여기서 또 안 넣어도 된다.

# postgres에 ai_app role 마이그레이션 후, ai_app을 GRANT할 전용 로그인 계정 (신규 생성 필요)
AI_RUNTIME_DB_USER=ai_runtime
AI_RUNTIME_DB_PASSWORD=change-me-strong-password

# Spring이 이미 콜백/presigned 다운로드 검증에 쓰고 있는 기존 HMAC 시크릿 — 새로 만들지 말고 그대로 재사용
AI_CALLBACK_SECRET=

# Spring↔ai-api 내부 인증(HMAC) 공유 시크릿 — ADR jinwoo/0001, canola/0023 §9
AI_INTERNAL_SECRET=

# GPU 서버(bge-runtime)와 공유하는 내부 토큰 — bge-runtime 실행 시 BGE_RUNTIME_INTERNAL_TOKEN과 동일해야 함
BGE_RUNTIME_INTERNAL_TOKEN=

# GMS(OpenAI 호환 게이트웨이) API 키 — ai-api가 답변 모델·RAG에 사용(AI_API_GMS_API_KEY로 주입).
# AI 소유. (배포는 --env-file .env.prod --env-file .env.ai-prod를 함께 읽는다.)
#
# 백엔드도 이 게이트웨이를 쓴다(ADR-0054, 판서 해석). 다만 <b>같은 값을 두 파일에 복사하지 않는다</b> —
# 백엔드 쪽은 .env.prod의 ANNOTATION_AI_API_KEY로 따로 준다. 한 값을 두 곳에 적으면 회전할 때 한쪽만
# 바뀌어 어긋난다. 같은 키를 쓸지 다른 키를 쓸지는 운영이 정한다.
GMS_API_KEY=

# 녹화강의 batch STT 전용 OpenAI API 키. GMS 키와 별개로 발급·회전한다.
OPENAI_API_KEY=

# ai-api Redis consumer 이름에 들어가는 EC2 내 고유 인스턴스 ID.
# 현재 강의 노트 MVP는 단일 ai-api replica만 운용한다.
AI_API_INSTANCE_ID=ai-api-1

# 강의 노트 생성 정책은 ai-api 코드와 compose 기본값을 사용한다.
# 의도적으로 튜닝할 때만 AI_API_LECTURE_NOTE_* override를 추가한다.

# 컨테이너 identity와 EC2 loopback 운영 포트. 코드 기본값에 기대지 않고 배포 정책을 고정한다.
AI_WORKER_INSTANCE_ID=ai-worker-1
AI_WORKER_SPRING_INTERNAL_BASE_URL=http://backend:8080
AI_WORKER_MANAGEMENT_HOST_PORT=8011
RECORDED_STT_INSTANCE_ID=recorded-stt-prod-1
RECORDED_STT_MANAGEMENT_HOST_PORT=8012
AI_API_HOST_PORT=8010

# PPTX 핵심 용어 추출(MR !228). 켜면 자료 인덱싱 때 GMS로 용어+정의를 뽑아 ai.material_key_term에 넣고,
# 그것이 강의 용어집의 베이스가 된다(ADR-0064 — 강사 수정본이 위에 덮인다).
# 켜려면 GMS_API_KEY가 있어야 한다(.env.prod에 이미 있다). 없으면 워커가 기동에 실패한다.
# docker-compose.ai-prod.yml의 environment에도 같은 이름이 있어야 컨테이너까지 전달된다.
AI_WORKER_KEY_TERM_EXTRACTION_ENABLED=false

# 강조 판서 색인(ADR-0074). 켜면 Spring이 보낸 강조 이미지를 텍스트로 옮겨 색인하고
# 영실이가 자료와 함께 근거로 쓴다. 켜려면 GMS_API_KEY가 있어야 한다.
# Spring 쪽 outbox가 아직 없어 켜도 잡이 오지 않는다 — 먼저 켜 두어도 무해하다.
AI_WORKER_ANNOTATION_INGESTION_ENABLED=false

# ai-api가 강조 판서를 RAG 근거로 검색할지(ADR-0074). 워커 스위치와 독립이며,
# 꺼져 있으면 라이브·다시보기 답변이 이 기능 이전과 완전히 동일하게 동작한다.
AI_API_ANNOTATION_EVIDENCE_ENABLED=false

# AI 서비스(ai-worker, ai-api) dev 환경변수 템플릿 — 복사해서 .env.ai-dev 로 채운다 (.env.ai-dev는 커밋 금지).
#   cp .env.ai-dev.example .env.ai-dev
# docker-compose.ai-dev.yml이 --env-file .env.dev --env-file .env.ai-dev 로 읽는다.
# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, REDIS_PASSWORD, RABBITMQ_USER, RABBITMQ_PASSWORD는
# .env.dev에 있으므로 여기서 또 안 넣어도 된다. dev redis는 requirepass(REDIS_PASSWORD)를 쓴다.

# dev postgres에 ai_app role 마이그레이션 후, ai_app을 GRANT할 전용 로그인 계정 (dev용, 신규 생성 필요)
AI_RUNTIME_DB_USER=ai_runtime
AI_RUNTIME_DB_PASSWORD=

# Spring이 콜백/presigned 다운로드 검증에 쓰는 HMAC 시크릿 — dev Spring이 쓰는 값과 동일해야 함
AI_CALLBACK_SECRET=

# Spring↔ai-api 내부 인증(HMAC) 공유 시크릿 (dev)
AI_INTERNAL_SECRET=

# GPU 서버(bge-runtime)와 공유하는 내부 토큰 — bge-runtime의 BGE_RUNTIME_INTERNAL_TOKEN과 동일해야 함(dev/prod 공용 GPU)
BGE_RUNTIME_INTERNAL_TOKEN=

# GMS(OpenAI 호환 게이트웨이) API 키 — ai-api가 답변 모델·RAG에 사용(AI_API_GMS_API_KEY로 주입).
GMS_API_KEY=

# 컨테이너 identity와 EC2 loopback 운영 포트. prod와 동시에 띄우므로 host port만 분리한다.
AI_WORKER_INSTANCE_ID=ai-worker-dev-1
# dev Docker network에는 Spring이 없으므로 실제로 도달 가능한 주소를 반드시 입력한다.
AI_WORKER_SPRING_INTERNAL_BASE_URL=
AI_WORKER_MANAGEMENT_HOST_PORT=18011
AI_API_INSTANCE_ID=ai-api-dev-1
AI_API_HOST_PORT=18010

# 강의 노트 생성 정책. 모델만 비우면 RAG와 같은 AI_API_GMS_MODEL을 사용한다.
AI_API_LECTURE_NOTE_MODEL=
AI_API_LECTURE_NOTE_MAX_OUTPUT_TOKENS=512
AI_API_LECTURE_NOTE_MAX_PROMPT_CHARS=20000
AI_API_LECTURE_NOTE_TIMEOUT_SECONDS=30
AI_API_LECTURE_NOTE_MIN_WINDOW_MS=15000
AI_API_LECTURE_NOTE_TARGET_WINDOW_MS=25000
AI_API_LECTURE_NOTE_MAX_WINDOW_MS=40000
AI_API_LECTURE_NOTE_MIN_CHARS=80
AI_API_LECTURE_NOTE_MAX_CHARS=400
AI_API_LECTURE_NOTE_STREAM_MAXLEN=10000
